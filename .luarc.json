{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "Lua 5.2"
  },
  "diagnostics": {
    "globals": [
      "game",
      "settings",
      "script",
      "storage",
      "prototypes",
      "entity",
      "defines",
      "data",
      "rendering",
      "mods",
      "log",
      "util",
      "table",
      "serpent",
      "table_size",
      "commands",
      "remote",
      "__DebugAdapter",
      "__Profiler"
    ],
    "disable": ["lowercase-global"]
  },
  "workspace": {
    "library": ["lib"],
    "checkThirdParty": false
  }
}
